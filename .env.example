# --- Supabase (Project Settings → API) ---------------------------------
# Si dejás estos placeholders, la app arranca en MODO DEMO con datos simulados.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# --- Cloudflare Turnstile (dash.cloudflare.com → Turnstile) -------------
# Site key (pública, va en el navegador) y secret key (privada, solo servidor).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=TU_SITE_KEY
TURNSTILE_SECRET_KEY=TU_SECRET_KEY

# --- URL del sitio (obligatorio en Vercel para el callback de Google) ---
# Local:  http://localhost:3000
# Vercel: https://tu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
